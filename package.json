{
  "name": "cockpit",
  "productName": "Cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Full-screen quest workspace with an AI companion",
  "keywords": [],
  "license": "UNLICENSED",
  "author": {
    "name": "MrKoods",
    "email": "nickcuda1228@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"orchestrator/**/*.test.ts\"",
    "measure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/measure.ts",
    "voice-latency": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/voice-latency.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "44.9.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "onnxruntime-web": "^1.30.0",
    "yaml": "^2.9.1"
  }
}
